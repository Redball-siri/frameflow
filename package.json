{
  "name": "video-story-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a video into a local transcript, editable PowerPoint deck, and B-roll direction plan.",
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "setup:visuals": "bash scripts/setup-local-visuals.sh",
    "title:strategy": "node scripts/title_strategy.mjs",
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2"
  }
}
